# Line-ending contract for the repository.
#
# Without this file the checkout depends on each author's core.autocrlf, which
# is how stack.sh came to sit in the working tree with CRLF endings: a
# shell script with CRLF fails at the shebang with "bad interpreter: ...^M".
#
# Everything is normalised to LF in the index. The working-tree ending is then
# forced per type, so the same clone is correct on Windows and on Unix.

* text=auto

*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell keeps CRLF in the working tree: Windows PowerShell 5.1 is the
# platform that runs it, and its here-strings are sensitive to the ending.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
