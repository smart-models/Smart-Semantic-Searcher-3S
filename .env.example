# Smart Semantic Searcher unified environment
# Copy this file to .env, configure the required values, then use scripts/stack.*.
# STACK_PROFILE selects the hardware target; SMART_EMBEDDER_PROFILE selects models.
# Commented assignments are optional overrides and show accepted values or formats.
#
# MINIMUM TO BOOT: a reachable Qdrant. The stack does not start one; QDRANT_URL
# (section 05) already points at an instance on this machine's default port
# 6333, so change it only if yours lives elsewhere. Everything else has a
# working default -- including authentication, which this template ships
# DISABLED so a fresh clone starts on the first try.
#
# READ SECTION 04 BEFORE THIS HOLDS ANYTHING YOU CARE ABOUT. As shipped, all
# three services accept every request with no bearer token. Every port stays
# published on 127.0.0.1, so nothing outside this machine can reach them -- but
# every process and every user on this host can read, rewrite and delete every
# collection. Section 04 has the four-step fix.
#
# CONVENTION: an uncommented assignment is the active default; a commented one is
# an optional override left to the service's own default.
#
# SECTIONS: 01 launcher profiles / 02 optional services / 03 ports / 04 auth /
# 05 Qdrant / 06-09 middleware limits, query, ingest, embedder client /
# 10-11 Smart Embedder shared / 12 BASIC models / 13-17 ADVANCED models /
# 18 storage / 19 MCP server / 20 collection schema.

# -----------------------------------------------------------------------------
# 01. Launcher profiles
# -----------------------------------------------------------------------------

# Hardware target used by scripts/stack.* when cpu or gpu is omitted on the CLI.
# Accepted values: cpu, gpu.
STACK_PROFILE=gpu

# Optional physical GPU for up/config/build/pull with gpu or CLI-only auto.
# Empty keeps normal behaviour; use an index or GPU- UUID/prefix, not a list.
# A CLI GPU selector wins. Full UUIDs are stable across enumeration changes.
STACK_GPU_DEVICE=

# Model family loaded by Smart Embedder. Only these two values are accepted;
# any other value fails startup instead of silently selecting another model.
# basic = BGE-M3; advanced = Qwen dense + MILCO sparse + Qwen reranker.
SMART_EMBEDDER_PROFILE=advanced

# The gpu + advanced pair shipped above is the highest-capability combination,
# not the lightest one: it downloads the larger model set and spends longer in
# the startup autotune. Switch both to cpu and basic for a smaller first run.

# -----------------------------------------------------------------------------
# 02. Optional services
# -----------------------------------------------------------------------------

# The three switches below are read by scripts/stack.* only, never by a
# service. Running `docker compose up` directly ignores them: it starts the
# middleware, the MCP server and the selected embedder, and no Qdrant.

# true starts only the selected Smart Embedder container and removes the
# middleware container. A bundled Qdrant is not started either.
EMBEDDER_ONLY=false

# false removes the smart-qdrant-mcp container from the stack: the launcher
# starts everything else and scales that one service to zero, stopping it if a
# previous run left it up. MCP_API_TOKENS then stops being checked. All the
# other MCP_* settings in section 19 keep their meaning for when it is enabled
# again. EMBEDDER_ONLY=true removes the MCP server regardless of this switch.
MCP_SERVER_ENABLED=true

# true starts a Qdrant 1.20 container inside this stack (Compose profile
# `qdrant`) and points the middleware at it over the private network: the
# launcher exports QDRANT_URL=http://qdrant:6333 over the value in section 05.
# QDRANT_API_KEY (section 05) must then be set; it becomes that instance's key.
# The instance is published on 127.0.0.1:QDRANT_PORT (section 03) for the
# Qdrant dashboard and host-side tools, and keeps its data in the volume named
# in section 18, which `down --volumes` deletes. EMBEDDER_ONLY=true wins:
# nothing would consume the database, so it is not started. false keeps Qdrant
# external and leaves QDRANT_URL as configured. A stale bundled container from
# an earlier run is removed by the next `up`.
QDRANT_BUNDLED=false

# -----------------------------------------------------------------------------
# 03. Published ports and native-run endpoints
# -----------------------------------------------------------------------------

# Host ports for the middleware and Smart Embedder. Container ports remain
# fixed at 6336 and 8000 respectively. Valid range: 1..65535.
MIDDLEWARE_PORT=6336
SMART_EMBEDDER_PORT=8010

# Host port of the bundled Qdrant (QDRANT_BUNDLED=true), always on 127.0.0.1;
# the container port stays 6333. Unused for an external Qdrant.
QDRANT_PORT=6333

# Host address the middleware (console and REST API) is published on. Loopback
# by default, so only this machine can open it. To reach it from other machines
# on a trusted private network or VPN without an SSH tunnel, set this server's
# own private IPv4 address (10.x, 172.16-31.x or 192.168.x). Public, hostname,
# link-local and wildcard (0.0.0.0) values are refused. A non-loopback value
# requires at least one token in MIDDLEWARE_API_TOKENS (section 04), and then
# /health, /readyz, /stats and /metrics require it too; only /livez stays
# public. The traffic is still plain HTTP, so the bearer token can be read on
# the network path. The
# Smart Embedder port always stays on 127.0.0.1; MCP has its own
# MCP_BIND_HOST (section 19).
MIDDLEWARE_BIND_HOST=127.0.0.1

# false stops publishing SMART_EMBEDDER_PORT on the host: scripts/stack.*
# applies compose.embedder-private.yml, which withdraws that one publish. The
# stack keeps working -- the middleware reaches the embedder over the private
# Compose network, not through this port -- and the only things that break are
# the host-side tools that target it directly: server-embedder-reranker's
# tests/test_server.py and benchmark.py.
#
# Set it to false for a deployment. The published port is the one way to reach
# the embedder without passing through the middleware, so it also bypasses the
# middleware's bearer auth, rate limiting, and QUERY_RERANK_MAX_CHARS
# truncation. SMART_EMBEDDER_API_TOKENS still guards it -- unless
# SMART_EMBEDDER_ALLOW_UNAUTHENTICATED_LOCAL=true, where this switch is the
# only thing left.
#
# Read by scripts/stack.* only; `docker compose up` run directly always
# publishes the port.
EXPOSE_SMART_EMBEDDER_PORT=true

# Native middleware bind address. Compose ignores this value, binds the process
# to 0.0.0.0 inside the container, and publishes it on MIDDLEWARE_BIND_HOST.
QDRANT_API_HOST=127.0.0.1

# Smart Embedder URL for native middleware execution. Compose overrides it with
# the private service address http://smart-embedder:8000.
SMART_EMBEDDER_URL=http://localhost:8010

# -----------------------------------------------------------------------------
# 04. Authentication and exposed surfaces
# -----------------------------------------------------------------------------

# Inbound bearer credentials, as a comma-separated token:label list. The label
# is what appears in the logs; the token is the secret a client sends as
# "Authorization: Bearer <token>". Labels must match [A-Za-z0-9._-]+ and must
# not start with '@', which is reserved for the credentials services present to
# each other. Revoke one person by deleting their entry and restarting.
#   MIDDLEWARE_API_TOKENS=k1a2b3:alice,k4c5d6:bob
MIDDLEWARE_API_TOKENS=
SMART_EMBEDDER_API_TOKENS=
# The MCP list is only consulted when MCP_AUTH_MODE=static (section 19); under
# oauth both this list and MCP_ALLOW_UNAUTHENTICATED_LOCAL are ignored.
MCP_API_TOKENS=

# The three lists must not share a token. scripts/verify_token_config.py runs
# before `up` and refuses the launch on an overlap, or on a service that
# requires authentication while its caller has no client token below.

# Outbound credentials: the single token a service presents when calling its
# neighbour. Each is auto-accepted by the target service, so it does NOT go in
# the list above -- set it once here and it works at both ends.
MIDDLEWARE_CLIENT_TOKEN=
SMART_EMBEDDER_CLIENT_TOKEN=

# Serve without any authentication when the matching list is empty. Each
# service has its own switch, and all three ship as `true`: this is the one
# deliberately insecure default in this file, and the only one.
#
# TO SECURE THE STACK: put a token:label entry in each of the three lists
# above, set the two *_CLIENT_TOKEN values, then set all three switches below
# back to `false`. A service whose list is empty while its switch is false
# refuses to start, so the two halves cannot silently half-apply.
#
# The Smart Embedder port stays published on 127.0.0.1 regardless. The
# middleware and MCP can be published on a private address, so their switches
# carry an extra condition: serving with an empty list and the switch true also
# requires a loopback MIDDLEWARE_BIND_HOST (section 03) or MCP_BIND_HOST
# (section 19), and that service refuses to start on any other address. Once
# its list holds a token, the switch no longer matters.
MIDDLEWARE_ALLOW_UNAUTHENTICATED_LOCAL=true
SMART_EMBEDDER_ALLOW_UNAUTHENTICATED_LOCAL=true
MCP_ALLOW_UNAUTHENTICATED_LOCAL=true

# Frontend controls the middleware console and /assets/config.js. Swagger flags
# control the public /docs, /redoc, and /openapi.json routes for each service.
# Startup CLI overrides: scripts/README.md, Startup calibration and console controls.
EXPOSE_FRONTEND=true
EXPOSE_MIDDLEWARE_SWAGGER=true
EXPOSE_SMART_EMBEDDER_SWAGGER=false

# -----------------------------------------------------------------------------
# 05. Qdrant connection and collection storage defaults
# -----------------------------------------------------------------------------

# Address of an external Qdrant. This default reaches an instance on the Docker
# host; use http://localhost:6333 for native runs. Ignored under
# QDRANT_BUNDLED=true (section 02), where the launcher exports the bundled
# instance's private address instead.
QDRANT_URL=http://host.docker.internal:6333
# API key of an external Qdrant, if it requires one. Under QDRANT_BUNDLED=true
# it is required and is also the key the bundled instance enforces; it must
# differ from every token in section 04.
QDRANT_API_KEY=

# Memory limit of the bundled Qdrant container, in Docker size syntax. It grows
# with the corpus: vectors not kept on disk live in RAM. Unused for an external
# Qdrant.
QDRANT_MEM_LIMIT=4g

# Empty means requests must provide collection_name explicitly.
QDRANT_COLLECTION=

# Qdrant client timeout in seconds. Valid range: 1..3600.
QDRANT_TIMEOUT=30

# Defaults applied when the middleware creates collections. These two are the
# commonly-adjusted pair; the rest of the collection-creation schema lives in
# section 20.
QDRANT_ON_DISK_PAYLOAD=true
QDRANT_SPARSE_FLOAT16=true

# -----------------------------------------------------------------------------
# 06. Middleware HTTP limits, rate limiting, probes, and retries
# -----------------------------------------------------------------------------

# Global middleware request deadline in seconds. Valid range: 1..3600.
MIDDLEWARE_REQUEST_TIMEOUT=30

# Maximum HTTP request-body size in bytes; 26214400 = 25 MiB.
# Valid range: 1..1000000000 (1 GB).
REQUEST_BODY_MAX_BYTES=26214400

# Per-client token-bucket refill rate and burst capacity.
# Valid range for both: 1..1000000.
MIDDLEWARE_RATE_LIMIT_REQUESTS_PER_MINUTE=300
MIDDLEWARE_RATE_LIMIT_BURST_SIZE=180

# Dependency probe interval and individual Smart Embedder probe timeout,
# both in seconds. Valid ranges: interval 1..3600, probe timeout 0.5..60.
HEALTH_PROBE_INTERVAL=15
EMBEDDER_PROBE_TIMEOUT=3.0

# Retryable operations use this many total attempts and an exponential backoff
# starting at RETRY_BASE_DELAY seconds, jittered to [0.5x, 1x] so concurrent
# callers do not retry in lockstep. A Retry-After header from Smart Embedder
# overrides the computed wait, capped at 5 seconds.
# Valid ranges: attempts 1..10, base delay 0.0..10.0.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.1

# -----------------------------------------------------------------------------
# 07. Middleware query defaults and bounds
# -----------------------------------------------------------------------------

# Invariants: each default must not exceed its maximum; candidate limits must
# also be greater than or equal to the corresponding result limits.
# Valid ranges: result limits 1..1000, candidate limits 1..10000.
QUERY_DEFAULT_LIMIT=10
QUERY_MAX_LIMIT=50
QUERY_DEFAULT_CANDIDATE_LIMIT=50
QUERY_MAX_CANDIDATE_LIMIT=200

# Reranking defaults. QUERY_RERANK_MAX_CHARS truncates each passage before it
# reaches the reranker; 0 disables truncation, which also removes the practical
# ceiling that keeps a request well under the model's own token limit.
# Valid ranges: default top-k >= 1, max top-k 1..1024, max chars 0..200000.
QUERY_DEFAULT_RERANK=true
QUERY_DEFAULT_RERANK_TOP_K=20
QUERY_MAX_RERANK_TOP_K=200
QUERY_RERANK_MAX_CHARS=1000

# Accepted fusion algorithms: rrf, dbsf.
QUERY_DEFAULT_FUSION=rrf

# true searches only indexed vector segments.
QUERY_INDEXED_ONLY=false

# Optional HNSW search breadth; leave unset to use Qdrant's default.
# Valid range when set: >= 1.
# QUERY_HNSW_EF=

# Quantized-search rescoring and oversampling factor. Oversampling range: 1..10.
QUERY_QUANTIZATION_RESCORE=true
QUERY_QUANTIZATION_OVERSAMPLING=2.0

# Comma-separated payload fields permitted in filters. Empty allows all fields.
# Valid ranges: depth 1..100, conditions 1..1000.
QUERY_FILTER_FIELD_ALLOWLIST=
QUERY_FILTER_MAX_DEPTH=20
QUERY_FILTER_MAX_CONDITIONS=100

# -----------------------------------------------------------------------------
# 08. Middleware ingest and export limits
# -----------------------------------------------------------------------------

# Maximum number of chunks one ingest request may carry, on both the file and
# the inline path. This is the limit that protects the process: ingest embeds
# every chunk before its first write, so one request holds every dense and
# sparse vector at once -- roughly 52 KB per point at DENSE_DIM=1024. Over the
# limit is HTTP 413 with nothing embedded; without it the container is
# OOM-killed and the caller just sees the connection drop. Raise it only
# together with the middleware's mem_limit in compose.yml.
# Valid range: 1..1000000.
INGEST_MAX_CHUNKS=10000

# Maximum size in bytes of a JSON file read from middleware-qdrant-manager/data/;
# this is not an HTTP upload-size limit. Valid range: 1..10000000000 (10 GB).
# The sandbox root itself is fixed in code and is not configurable here.
# INGEST_MAX_CHUNKS above is the bound that actually protects memory: a file
# well under this size, full of small chunks, can still be far too many points.
INGEST_MAX_FILE_BYTES=67108864

# Qdrant upload batching. The default batch must not exceed the maximum.
# Valid ranges: default 1..256, maximum 1..1024, concurrency 1..16.
INGEST_DEFAULT_BATCH_SIZE=64
INGEST_MAX_BATCH_SIZE=256
INGEST_UPLOAD_CONCURRENCY=4

# Where POST /points/export writes files (inside the container). Mounted
# read-write from ./middleware-qdrant-manager/exports on the host.
EXPORT_DATA_ROOT=/app/middleware-qdrant-manager/exports
# Refuse larger exports (HTTP 413), checked before and during the walk.
# The middleware container is limited to 1 GB; review memory when raising caps.
# Valid range: >= 1.
EXPORT_MAX_POINTS=50000
# Entire UTF-8 JSON document, including metadata, escaping and formatting.
# An upstream scroll page and Python object overhead are outside this byte cap.
EXPORT_MAX_BYTES=67108864
# Per-process simultaneous exports. Excess requests receive retryable HTTP 503.
EXPORT_MAX_CONCURRENT=1

# -----------------------------------------------------------------------------
# 09. Middleware client for Smart Embedder
# -----------------------------------------------------------------------------

# Per-call timeout in seconds and middleware-side sub-batch/concurrency limits.
# SMART_EMBEDDER_URL is configured in section 03 and overridden by Compose.
# Valid ranges: timeout 1..3600, batch sizes 1..128, concurrency 1..16.
SMART_EMBEDDER_TIMEOUT=60
SMART_EMBEDDER_MAX_BATCH_SIZE=32
SMART_EMBEDDER_RERANK_BATCH_SIZE=32
SMART_EMBEDDER_EMBED_CONCURRENCY=4

# -----------------------------------------------------------------------------
# 10. Smart Embedder service limits and shared runtime controls
# -----------------------------------------------------------------------------

# NOTE ON NAMING: the Smart Embedder process reads every variable in this
# section without the SMART_EMBEDDER_ prefix -- REQUEST_TIMEOUT, MAX_QUEUE_SIZE,
# RERANK_MAX_QUEUE and so on. Compose does the renaming when it builds the
# container environment, so the prefixed names are the ones to set here. Only a
# Smart Embedder started by hand, outside Compose, needs the unprefixed names in
# its own environment.
#
# A few settings declared in other sections are renamed to something other than
# the bare suffix (host name -> in-container name):
#   SMART_EMBEDDER_PROFILE               -> EMBEDDER_PROFILE
#   SMART_EMBEDDER_API_TOKENS            -> API_TOKENS
#   SMART_EMBEDDER_CLIENT_TOKEN          -> SERVICE_TOKEN
#   SMART_EMBEDDER_LENGTH_AWARE_BATCHING -> EMBED_LENGTH_AWARE_BATCHING
#
# Not renamed at all:
#   SMART_EMBEDDER_PORT                        (published host port, never
#                                               passed to the process)
#   SMART_EMBEDDER_ALLOW_UNAUTHENTICATED_LOCAL (passed through unchanged)
#   EXPOSE_SMART_EMBEDDER_SWAGGER              (passed through unchanged)

# Global HTTP deadline and per-inference deadlines, in seconds. Keep inference
# deadlines below the global deadline so the service can return a controlled 504.
# Valid range for all three: 1..3600.
SMART_EMBEDDER_REQUEST_TIMEOUT=90
SMART_EMBEDDER_EMBED_GPU_TIMEOUT=60
SMART_EMBEDDER_RERANK_GPU_TIMEOUT=60

# Maximum admitted embedding and reranking work queues.
# Valid range for both: 1..10000.
SMART_EMBEDDER_MAX_QUEUE_SIZE=200
# Shared embedding/reranking admission; positive token units and estimated JSON
# output bytes. These estimates do not cap physical RAM/VRAM. Oversize: 413;
# temporarily occupied capacity: 503 with Retry-After. Native work retains its
# reservation after caller cancellation until its actual worker completes.
SMART_EMBEDDER_MAX_INFLIGHT_TOKENS=1048576
SMART_EMBEDDER_MAX_INFLIGHT_OUTPUT_BYTES=268435456
SMART_EMBEDDER_RERANK_MAX_QUEUE=32

# GPU memory held back from the reranker's per-batch token budget, in MiB.
# The budget is derived at startup from measured headroom; this reserve
# covers allocator overhead and non-logits activations. Lower it only with
# measurements from /metrics gpu_memory_* gauges.
# Valid range: 0..65536.
SMART_EMBEDDER_VRAM_RESERVE_MB=512

# Set false to disable the batch-halving fallback on VRAM exhaustion.
# Detection, the typed 413/503 error and the cache release stay active
# either way; only the automatic retry at a smaller batch is switched off.
SMART_EMBEDDER_OOM_FALLBACK=true

# Per-client token-bucket refill rate and burst capacity.
# Valid range for both: 1..1000000.
SMART_EMBEDDER_RATE_LIMIT_REQUESTS_PER_MINUTE=3600
SMART_EMBEDDER_RATE_LIMIT_BURST_SIZE=120

# Structural request limits: item counts and maximum UTF-8 bytes per item.
# These are checked after the body has been fully deserialized, so they bound
# what is processed rather than what is read.
# Valid ranges: item counts 1..1000000, item bytes 1..100000000.
SMART_EMBEDDER_MAX_SENTENCES_PER_REQUEST=2048
SMART_EMBEDDER_MAX_PASSAGES_PER_REQUEST=2048
SMART_EMBEDDER_MAX_ITEM_BYTES=1000000

# Maximum bytes of one HTTP request body, counted while it streams in and
# therefore the limit a caller meets first: over it is HTTP 413 and the body is
# never materialized. Without it the three limits above make a 2 GB request
# (2048 x 1 MB) legal. 64 MiB clears anything the middleware relays -- its own
# inbound cap is 25 MiB -- so lowering it below that can refuse legitimate
# internal traffic. Valid range: 1024..2147483648.
SMART_EMBEDDER_REQUEST_BODY_MAX_BYTES=67108864

# Group inputs by estimated token length before micro-batching, then restore
# their original API order.
SMART_EMBEDDER_LENGTH_AWARE_BATCHING=true

# Optional shared CPU intra-op and inter-op thread overrides. Leave unset for
# device-aware autotuning/runtime defaults. Valid range: intra-op 1..1024 on
# BASIC (ADVANCED caps it at its own detected CPU limit), inter-op 1..1024.
# EMBEDDER_NUM_THREADS=8
# EMBEDDER_INTEROP_THREADS=1

# Cap for the native OpenMP/OpenBLAS/MKL thread pools (OMP_NUM_THREADS and
# friends) in the embedder containers. Without it they size to every host CPU
# instead of the container's 4-CPU quota, which on many-core hosts exceeds the
# container pids limit and crashes model loading. Keep it equal to `cpus:`.
# SMART_EMBEDDER_NATIVE_THREADS=4

# -----------------------------------------------------------------------------
# 11. Hardware autotuning shared by BASIC and ADVANCED
# -----------------------------------------------------------------------------

# Modes: off, quick, full. Objectives: balanced, throughput, latency.
# quick is the normal startup calibration; full is an operator-triggered audit.
# Mode selection and one-invocation force: see scripts/README.md.
# SMART_EMBEDDER_AUTOTUNE=quick
# SMART_EMBEDDER_TUNING_OBJECTIVE=balanced

# true ignores a compatible cached profile whenever preparation runs while true.
# This is persistent; use the launcher force flag for one requested attempt.
# SMART_EMBEDDER_AUTOTUNE_FORCE=false

# Persisted profile paths inside the hardware-specific state volume.
# SMART_EMBEDDER_AUTOTUNE_PROFILE=/app/runtime_state/autotune/hardware-profile.json
# SMART_EMBEDDER_ADVANCED_AUTOTUNE_PROFILE=/app/runtime_state/autotune/advanced-hardware-profile.json

# Optional fixed budgets in seconds. Leave unset for mode/device defaults:
# BASIC quick=120, full=600; ADVANCED quick CUDA=240, quick CPU=360, full=1800.
# Left unset, the ADVANCED quick budget adapts: once the baseline is measured it
# grows to fit the planned candidates, up to 3x its default (720 s CUDA, 1,080 s
# CPU). A value set here is a fixed limit and turns that adaptation off.
# The ADVANCED-specific value takes precedence over the shared value.
# SMART_EMBEDDER_AUTOTUNE_MAX_SECONDS=
# SMART_EMBEDDER_ADVANCED_AUTOTUNE_MAX_SECONDS=

# -----------------------------------------------------------------------------
# 12. BASIC profile: BGE embedding and reranking
#     (ignored when SMART_EMBEDDER_PROFILE=advanced)
# -----------------------------------------------------------------------------

# Token limits, in tokens. BGE_EMBED_MAX_LENGTH and BGE_RERANK_MAX_LENGTH are
# read by the service and validated to 1..8192; both defaults are already the
# model's ceiling, so they can only be lowered.
BGE_EMBED_MAX_LENGTH=8192
BGE_RERANK_MAX_LENGTH=8192

# BGE_EMBED_CPU_MAX_LENGTH is not read by the service at all: Compose
# substitutes it in place of BGE_EMBED_MAX_LENGTH for the CPU container only,
# keeping long requests within the default service deadline. The GPU container
# gets the full BGE_EMBED_MAX_LENGTH.
BGE_EMBED_CPU_MAX_LENGTH=2048

# Optional micro-batch and CPU inference-lane overrides. Leave unset to use the
# validated hardware profile or conservative device-aware defaults.
# Valid ranges: both batch sizes 1..512; inference concurrency is bounded by the
# lane limit detected for the running hardware.
# Setting BGE_EMBED_BATCH_SIZE is not a fallback -- it replaces the calibrated
# length-aware batch policy with one fixed batch size for every input length.
# BGE_EMBED_BATCH_SIZE=8
# BGE_EMBED_INFERENCE_CONCURRENCY=2
# BGE_RERANK_BATCH_SIZE=8

# Embedding runtime: auto, torch, onnx-fp32, onnx-int8. ONNX is CPU-only and
# requires a validated cached graph; INT8 remains quality-gated.
# BGE_EMBED_RUNTIME=auto

# CPU ONNX Runtime graph scheduler and worker spin policy.
# BGE_ONNX_EXECUTION_MODE=auto  # auto|sequential|parallel
# BGE_ONNX_SPIN_POLICY=auto     # auto|default|bounded|disabled

# Compile policy: auto|on|off. Compile modes: default, reduce-overhead,
# max-autotune, max-autotune-no-cudagraphs.
BGE_TORCH_COMPILE=auto
BGE_TORCH_COMPILE_MODE=default

# -----------------------------------------------------------------------------
# 13. ADVANCED profile: Qwen dense embedding
#     (ignored when SMART_EMBEDDER_PROFILE=basic)
# -----------------------------------------------------------------------------

# Token limit read by the service, validated to 1..32768. The default is
# already the model's ceiling, so it can only be lowered.
QWEN_EMBED_MAX_LENGTH=32768

# Not read by the service: Compose substitutes it in place of
# QWEN_EMBED_MAX_LENGTH for the CPU container only. This cap was calibrated
# against the 16 GiB container limit; raising it requires more memory and forces
# a new hardware-profile fingerprint.
QWEN_EMBED_CPU_MAX_LENGTH=2048

# Optional scalar fallbacks used when no length-aware policy is selected.
# Valid ranges: batch size 1..1000000, batch tokens 1..1000000.
# QWEN_EMBED_BATCH_SIZE=8
# QWEN_EMBED_MAX_BATCH_TOKENS=8192

# Runtime: torch, onnx-fp32, onnx-int8. ONNX is CPU-only and requires a
# validated cached export; openvino is not supported by this build.
# QWEN_EMBED_RUNTIME=

# Precision: fp16|bf16|fp32 (default CUDA fp16, CPU fp32).
# Attention: sdpa|eager|flash_attention_2.
# QWEN_EMBED_PRECISION=
# QWEN_EMBED_ATTENTION=

# Optional boolean compile, transfer, and one-batch-ahead prefetch overrides.
# Compile modes: default, reduce-overhead, max-autotune,
# max-autotune-no-cudagraphs.
# QWEN_EMBED_TORCH_COMPILE=
# QWEN_EMBED_TORCH_COMPILE_MODE=
# QWEN_EMBED_PINNED_MEMORY=
# QWEN_EMBED_PREFETCH_BATCHES=

# Cache directory for validated ADVANCED ONNX exports.
# SMART_EMBEDDER_ADVANCED_ONNX_CACHE=/app/runtime_state/autotune/onnx

# -----------------------------------------------------------------------------
# 14. ADVANCED profile: MILCO learned-sparse embedding
#     (ignored when SMART_EMBEDDER_PROFILE=basic)
# -----------------------------------------------------------------------------

# Valid ranges: max length 1..32768, batch tokens 1..1000000,
# projection chunk 1..8192.
MILCO_MAX_LENGTH=8192
MILCO_MAX_BATCH_TOKENS=8192
MILCO_PROJECTION_CHUNK_TOKENS=128

# Optional scalar fallback used when no length-aware policy is selected.
# Valid range: 1..1000000.
# MILCO_BATCH_SIZE=8

# Add LexEcho source-language entities alongside the shared English pivot view.
MILCO_SOURCE_VIEW=true

# Optional per-vector sparse pruning; 0 preserves every non-zero weight.
# Valid range: 0..100000.
MILCO_TOP_K=0

# Runtime: torch only; any other value fails startup. Precision defaults: CUDA
# fp16/bf16 compute; CPU fp32/fp32 compute.
# MILCO_RUNTIME=
# MILCO_PRECISION=
# MILCO_COMPUTE_PRECISION=

# Optional boolean compile, transfer, and bounded double-buffer overrides.
# Compile modes: default, reduce-overhead, max-autotune,
# max-autotune-no-cudagraphs.
# MILCO_TORCH_COMPILE=
# MILCO_TORCH_COMPILE_MODE=
# MILCO_PINNED_MEMORY=
# MILCO_PREFETCH_BATCHES=

# -----------------------------------------------------------------------------
# 15. ADVANCED profile: Qwen reranker
#     (ignored when SMART_EMBEDDER_PROFILE=basic)
# -----------------------------------------------------------------------------

# Device-aware Compose defaults when unset: CPU length=2048/batch=1;
# GPU length=32768/batch=8. Valid ranges: length 1..32768 (the GPU default is
# already the model's ceiling), batch 1..512.
# Raising the length invalidates the cached ADVANCED hardware profile and forces
# one recalibration on the next start. Note that the middleware's own
# QUERY_RERANK_MAX_CHARS truncation (section 07) is what usually keeps requests
# far below this cap; a direct call to the Smart Embedder /rerank endpoint
# bypasses it and can reach the full length.
# QWEN_RERANK_MAX_LENGTH=
# QWEN_RERANK_BATCH_SIZE=

# Runtime: torch only; any other value fails startup. Precision defaults: CUDA
# fp16, CPU fp32.
# Attention: sdpa|eager|flash_attention_2.
# QWEN_RERANK_RUNTIME=
# QWEN_RERANK_PRECISION=
# QWEN_RERANK_ATTENTION=

# Optional boolean compile override. Compile modes: default, reduce-overhead,
# max-autotune, max-autotune-no-cudagraphs.
# QWEN_RERANK_TORCH_COMPILE=
# QWEN_RERANK_TORCH_COMPILE_MODE=

# -----------------------------------------------------------------------------
# 16. ADVANCED scheduling and CPU topology overrides
#     (ignored when SMART_EMBEDDER_PROFILE=basic)
# -----------------------------------------------------------------------------

# Empty values let the validated hardware profile decide.
# ADVANCED_SCHEDULE_MODE=          # sequential|overlap|parallel
# ADVANCED_INFERENCE_LANES=        # 1..8
# ADVANCED_QUEUE_BATCH=            # max coalesced HTTP requests, 1..1024
# ADVANCED_FLUSH_TIMEOUT_MS=        # queue accumulation bound, 1..60000 ms
# ADVANCED_CPU_SPIN_POLICY=         # default|passive|active
# ADVANCED_CPU_AFFINITY=            # none|compact|socket-local
# ADVANCED_CPU_ALLOW_OVERSUBSCRIPTION=  # boolean; safe fallback is false

# -----------------------------------------------------------------------------
# 17. Expert-only ADVANCED length-aware policies
#     (ignored when SMART_EMBEDDER_PROFILE=basic)
# -----------------------------------------------------------------------------

# Normally generated by the tuner (quick or full) and persisted in the profile.
# Set only with audited measurements; a value set here is fingerprinted. Each
# value is a JSON array; empty leaves the profile in control.
# Batch schema: [{"max_tokens":512,"batch_size":8},...]
# Token-budget schema: [{"max_tokens":512,"max_batch_tokens":8192},...]
# QWEN_EMBED_BATCH_POLICY=
# QWEN_EMBED_MAX_BATCH_TOKENS_POLICY=
# MILCO_BATCH_POLICY=
# MILCO_MAX_BATCH_TOKENS_POLICY=
# QWEN_RERANK_BATCH_POLICY=
# QWEN_RERANK_MAX_BATCH_TOKENS_POLICY=

# -----------------------------------------------------------------------------
# 18. Docker model and runtime storage
# -----------------------------------------------------------------------------

# These four name Docker volumes. Renaming one after the first `up` does not
# move any data: Compose creates a new, empty volume under the new name and the
# old one is left behind. That means a full model re-download for the model
# cache, a lost hardware profile (so a full recalibration) for the state
# volumes, and an empty database for the Qdrant volume. Rename only
# deliberately, and clean up the orphaned volume yourself.

# The preparation container writes pinned model snapshots; the serving process
# mounts this volume read-only.
HF_MODEL_CACHE_VOLUME=smart-embedder-hf-cache

# Hugging Face download transport for the preparation containers. 1 uses plain
# HTTP, which writes each file as it arrives and resumes it after a dropped
# connection. 0 allows Xet, which can be faster on a stable link but can hold a
# partial file in memory and lose it once its retries run out.
# SMART_EMBEDDER_HF_HUB_DISABLE_XET=1

# Hardware-specific preparation state. Serving mounts both volumes read-only.
SMART_EMBEDDER_CPU_STATE_VOLUME=smart-embedder-state-cpu
SMART_EMBEDDER_GPU_STATE_VOLUME=smart-embedder-state-gpu

# Storage of the bundled Qdrant (QDRANT_BUNDLED=true): every collection, vector
# and snapshot. `down --volumes` deletes it, which is why that flag asks for
# confirmation. Unused for an external Qdrant.
QDRANT_STORAGE_VOLUME=smart-semantic-searcher-qdrant

# Non-persistent executable tmpfs used for TorchInductor/Triton generated code.
SMART_EMBEDDER_RUNTIME_CACHE_SIZE=2g

# GPU-only PyTorch allocator setting. expandable_segments reduces fragmentation;
# throw_on_cudamalloc_oom is documented for inference serving -- it makes an
# allocation failure raise a catchable OutOfMemoryError instead of aborting
# the process, so the reranker can reject one request and keep serving.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,throw_on_cudamalloc_oom:True

# -----------------------------------------------------------------------------
# 19. MCP server (smart-qdrant-mcp)
# -----------------------------------------------------------------------------

# Application/image version reported in MCP serverInfo and OCI metadata.
SMART_QDRANT_MCP_VERSION=1.0.0

# Authentication mode: "static" keeps locally provisioned bearer tokens;
# "oauth" validates opaque access tokens through RFC 7662 introspection and
# publishes OAuth protected-resource metadata.
MCP_AUTH_MODE=static

# The inbound bearer tokens this mode consults, MCP_API_TOKENS, live with the
# other two token lists in section 04.

# Required only when MCP_AUTH_MODE=oauth. The issuer, resource-server and
# introspection URLs must use HTTPS; plain HTTP is accepted only for an
# explicitly loopback host (localhost, 127.0.0.0/8 or ::1) during local
# development. The audience defaults to the resource-server URL when
# MCP_OAUTH_AUDIENCE is empty. Required scopes are a comma-separated list
# enforced by the MCP authentication middleware.
MCP_OAUTH_ISSUER_URL=
MCP_OAUTH_RESOURCE_SERVER_URL=
MCP_OAUTH_INTROSPECTION_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_REQUIRED_SCOPES=

# Publish address for the MCP endpoint -- what Compose publishes the port
# on, what scripts/verify_compose_security.py polices, and what seeds the
# Host allowlist and issuer URL. Never reaches a socket itself. Loopback by
# default. Loopback (including ::1) or an IPv4 RFC1918 literal is accepted; public,
# hostname, link-local, multicast and wildcard values are refused at startup.
MCP_BIND_HOST=127.0.0.1

# The address uvicorn actually binds to, inside this process's own network
# namespace -- a different question from MCP_BIND_HOST above. Defaults to
# loopback so running the server outside Docker (with no container
# namespace or published-port restriction to lean on) is safe by default.
# Unlike MCP_BIND_HOST, 0.0.0.0 is accepted here: the smart-qdrant-mcp compose
# service sets it explicitly, because binding all interfaces inside its own
# private namespace is exactly what the published-port restriction assumes.
MCP_LISTEN_HOST=127.0.0.1

# Valid range: 1..65535.
MCP_PORT=6337

# Where the MCP server reaches the middleware. Compose overrides this with the
# private-network hostname (http://middleware:6336); the loopback default is for
# running the server outside Docker.
MCP_MIDDLEWARE_URL=http://127.0.0.1:6336

# Extra Host header values to accept, comma separated (e.g. your VPN hostname).
# Loopback and localhost are always allowed.
MCP_ALLOWED_HOSTS=

# Allowed Origin header values, comma separated. Empty means same-origin only.
MCP_ALLOWED_ORIGINS=

# Valid ranges: timeout > 0, attempts 1..10, backoff > 0.
MCP_HTTP_TIMEOUT=120
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_BACKOFF_SECONDS=0.5

# -----------------------------------------------------------------------------
# 20. Collection-creation schema defaults (middleware, advanced)
# -----------------------------------------------------------------------------

# These complete the collection-creation schema begun in section 05: together
# they control the shape of every collection the middleware creates. They were
# always readable from the environment; this section documents them rather than
# adding anything new. Compose does not pass them and does not mount the repo
# .env into the middleware container, so they take effect for a natively-run
# middleware, or after you add them to compose.yml yourself.
#
# Changing any of these does NOT rewrite collections that already exist -- the
# middleware's schema check will simply start reporting the existing ones as
# divergent. DENSE_DIM in particular must match the active embedding model's
# output dimension; a mismatch leaves a newly created collection unusable for
# ingest. Defaults are shown; leave the section commented out to keep them.
#
# Accepted values are annotated inline here rather than above each group. These
# settings have a floor and no ceiling, so they read ">= N" instead of the
# "Valid range: N..M" form used by the bounded settings elsewhere in this file.

# Named vectors and dense dimension. 1024 is the output dimension of both
# pinned embedding models (BAAI/bge-m3 and Qwen/Qwen3-Embedding-0.6B), so it
# is correct for either profile.
# DENSE_VECTOR_NAME=dense
# SPARSE_VECTOR_NAME=sparse
# DENSE_DIM=1024                    # >= 1

# Dense HNSW graph. HNSW_M=0 disables the global graph, leaving Qdrant to full
# scan the dense vectors.
# HNSW_M=16                         # >= 0
# HNSW_EF_CONSTRUCT=200             # >= 1
# HNSW_FULL_SCAN_THRESHOLD=10000    # >= 0
# HNSW_INLINE_STORAGE=true

# Dense and sparse storage placement and scoring.
# DENSE_ON_DISK=true
# DENSE_FLOAT16=true
# SPARSE_ON_DISK=true
# SPARSE_FULL_SCAN_THRESHOLD=20000  # >= 0
# SPARSE_IDF=true

# Scalar quantization of the dense vectors.
# QUANTIZATION_ENABLED=true
# QUANTIZATION_ALWAYS_RAM=true

# Optimizer thresholds. Keeping these equal is the balanced default.
# INDEXING_THRESHOLD=20000          # >= 0
# MEMMAP_THRESHOLD=20000            # >= 0
# PREVENT_UNOPTIMIZED=true

# Sharding and replication. Meaningful only against a Qdrant cluster.
# SHARD_NUMBER=1                    # >= 1
# REPLICATION_FACTOR=1              # >= 1
